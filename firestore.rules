rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isItemOwner(itemData) {
      return isAuthenticated() && (
        itemData.ownerId == request.auth.uid ||
        (itemData.ownerEmail != null && request.auth.token.email != null && itemData.ownerEmail == request.auth.token.email)
      );
    }

    function isRequestParticipant(reqData) {
      return isAuthenticated() && (
        reqData.borrowerId == request.auth.uid ||
        reqData.ownerId == request.auth.uid ||
        (reqData.borrowerEmail != null && request.auth.token.email != null && reqData.borrowerEmail == request.auth.token.email) ||
        (reqData.ownerEmail != null && request.auth.token.email != null && reqData.ownerEmail == request.auth.token.email)
      );
    }

    // =========================================================================
    // 1. ITEMS COLLECTION
    // =========================================================================
    match /items/{itemId} {
      // Authenticated students can browse available campus items
      allow read: if isAuthenticated() || true;

      // Only authenticated students can list new items with initial available status
      allow create: if isAuthenticated() && (
        (request.resource.data.ownerId == request.auth.uid ||
         (request.resource.data.ownerEmail != null && request.resource.data.ownerEmail == request.auth.token.email)) &&
        request.resource.data.status in ['available', 'requested']
      );

      // Updates: Strictly enforce authorization and status state machine
      allow update: if isAuthenticated() && (
        // Case A: Only the verified owner can:
        // - Edit item title, condition, deposit, rent
        // - Confirm Handover (transition to 'unavailable' and assign borrowedBy)
        // - Confirm Return (transition back to 'available' and clear borrowedBy)
        (
          isItemOwner(resource.data) &&
          // Prevent transferring item ownership to another user
          request.resource.data.ownerId == resource.data.ownerId
        ) ||
        // Case B: A student borrower can ONLY transition an item from 'available' to 'requested'
        // - Borrowers CANNOT mark an item as 'available'
        // - Borrowers CANNOT mark an item as 'unavailable'
        // - Borrowers CANNOT change price, deposit, location, or ownership
        (
          resource.data.status == 'available' &&
          request.resource.data.status == 'requested' &&
          (request.resource.data.borrowedBy == request.auth.uid || 
           request.resource.data.borrowerId == request.auth.uid) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.rent == resource.data.rent &&
          request.resource.data.deposit == resource.data.deposit
        )
      );

      // Only the verified owner can delete their item
      allow delete: if isItemOwner(resource.data);
    }

    // =========================================================================
    // 2. RENTAL REQUESTS COLLECTION
    // =========================================================================
    match /rental_requests/{requestId} {
      // Students cannot inspect another student's rental requests
      allow read: if isRequestParticipant(resource.data);

      // Authenticated students can only create rental requests for themselves
      allow create: if isAuthenticated() && (
        request.resource.data.borrowerId == request.auth.uid ||
        (request.resource.data.borrowerEmail != null && request.resource.data.borrowerEmail == request.auth.token.email)
      );

      // Only the lender or borrower can update the request
      allow update: if isAuthenticated() && (
        // Lender can Accept, Reject, Handover, or Complete
        isItemOwner(resource.data) ||
        // Borrower can only cancel if it's still Pending
        (
          (resource.data.borrowerId == request.auth.uid || resource.data.borrowerEmail == request.auth.token.email) &&
          resource.data.status == 'Pending' &&
          request.resource.data.status == 'Cancelled'
        )
      );

      // Only owner or borrower can delete their request record
      allow delete: if isRequestParticipant(resource.data);
    }

    // =========================================================================
    // 3. PRIVATE MESSAGES & THREADS
    // =========================================================================
    match /messages/{messageId} {
      // Only the message sender or recipient can read the chat message
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        (resource.data.senderEmail != null && resource.data.senderEmail == request.auth.token.email) ||
        (resource.data.recipientEmail != null && resource.data.recipientEmail == request.auth.token.email)
      );

      // Authenticated students can send a message as themselves
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.senderEmail == request.auth.token.email ||
        request.resource.data.sender != null
      );

      allow update, delete: if false; // Messages are immutable
    }

    // =========================================================================
    // 4. STUDENT PROFILES
    // =========================================================================
    match /users/{userId} {
      // Authenticated students can view peer profiles and trust scores
      allow read: if isAuthenticated();

      // Only the student can create or update their own profile
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
